# ─── Resource server policy ───────────────────────────────────────────

# Required. Signet issuer URL. It must match the issuer returned by OIDC
# discovery and the credential's verified `iss` value byte-for-byte.
SIGNET_URL=https://auth.example.com

# Required. The one Signet Client App accepted by this resource server.
# JWT access tokens and Personal API Keys must both belong to this app.
CLIENT_ID=your-client-id

# Required unless SKIP_AUDIENCE_CHECK=1. The `aud` value required on JWT
# access tokens. Personal API Keys do not carry an audience, but still pass
# the same issuer, Client App, and scope policy.
EXPECTED_AUDIENCE=https://api.example.com

# Secure default: 0. Set to exactly 1 only when the issuer genuinely does not
# bind access tokens to an audience. EXPECTED_AUDIENCE must then be empty.
SKIP_AUDIENCE_CHECK=0

# Optional. Whitespace-separated, all-of scope policy. Leave empty to require
# no scope. Matching is exact and case-sensitive for both credential kinds.
REQUIRED_SCOPES=profile

# Optional, all-or-nothing pair. Leave both empty to verify Personal API Keys
# with GET /oauth/tokeninfo. Set both to use RFC 7662 POST /oauth/introspect.
# With Signet's default ownership policy, these credentials should belong to
# the same Client App named by CLIENT_ID.
INTROSPECTION_CLIENT_ID=
INTROSPECTION_CLIENT_SECRET=

# Optional. net/http listen address. Default: :8080.
SERVER_ADDR=:8080

# ─── Example client ───────────────────────────────────────────────────

# Optional. Protected endpoint called by ./client.
# Default: http://localhost:8080/api/whoami
API_URL=http://localhost:8080/api/whoami

# Required by ./client only. Paste either one JWT access token or one complete
# Personal API Key (sgk_ + 52 lowercase base32 characters). Never commit a
# populated .env file; a Personal API Key is shown only once when created.
BEARER_TOKEN=
