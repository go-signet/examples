# Run all commands from go-obo/. Environment variables override this file.
# Shared issuer. HTTPS normally; HTTP is accepted only for loopback development.
SIGNET_URL=https://YOUR-SIGNET-HOST

# Web frontend F: confidential authorization-code client. Secret stays in Web.
WEB_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID
WEB_CLIENT_SECRET=REPLACE_WITH_WEB_CLIENT_SECRET
WEB_ADDR=127.0.0.1:8090
WEB_REDIRECT_URL=http://127.0.0.1:8090/callback

# CLI frontend F: PUBLIC authorization-code client with PKCE; no secret.
CLI_CLIENT_ID=REPLACE_WITH_CLI_CLIENT_ID
CLI_CALLBACK_ADDR=127.0.0.1:8093

# API A: confidential OBO actor. Only A needs this secret.
# API B needs API_A_CLIENT_ID to validate client_id and act.sub.
API_A_CLIENT_ID=REPLACE_WITH_API_A_CLIENT_ID
API_A_CLIENT_SECRET=REPLACE_WITH_API_A_CLIENT_SECRET
API_A_ADDR=127.0.0.1:8091

# API B: separate confidential client used only to authenticate introspection.
API_B_CLIENT_ID=REPLACE_WITH_API_B_INTROSPECTION_CLIENT_ID
API_B_CLIENT_SECRET=REPLACE_WITH_API_B_INTROSPECTION_CLIENT_SECRET
API_B_ADDR=127.0.0.1:8092

# Audience identifiers, not HTTP destinations. Keep these exact strings in
# Signet client allowlists, API resources, policies and consent bundles.
API_A_AUDIENCE=https://api-a.example.com
API_B_AUDIENCE=https://api-b.example.com

# Actual HTTP destinations: Web/CLI -> A; A -> B.
API_A_URL=http://127.0.0.1:8091
API_B_URL=http://127.0.0.1:8092
